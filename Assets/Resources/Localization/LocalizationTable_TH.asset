  - key: company/company_gray_tower/playerReaction/0/text
    english: A bank. The building looks like it never sleeps.
    thai: "\u0E18\u0E19\u0E32\u0E04\u0E32\u0E23... \u0E15\u0E36\u0E01\u0E19\u0E35\u0E49\u0E14\u0E39\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E44\u0E21\u0E48\u0E40\u0E04\u0E22\u0E2B\u0E25\u0E31\u0E1A\u0E40\u0E25\u0E22"
