  entries:
  - key: database/genderPrompt
    english: Select gender...
    thai: "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E40\u0E1E\u0E28..."
  - key: database/genders/male
    english: Male
    thai: "\u0E0A\u0E32\u0E22"
  - key: database/genders/female
    english: Female
    thai: "\u0E2B\u0E0D\u0E34\u0E07"
  - key: database/resumeIntroLines/0/lines/0
    english: This is me, on paper.
    thai: "\u0E19\u0E35\u0E48\u0E04\u0E37\u0E2D\u0E09\u0E31\u0E19 \u0E1A\u0E19\u0E01\u0E23\u0E30\u0E14\u0E32\u0E29"
  - key: database/resumeIntroLines/0/lines/1
    english: What this shit
    thai: "\u0E19\u0E35\u0E48\u0E21\u0E31\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E31\u0E19\u0E40\u0E19\u0E35\u0E48\u0E22"
  - key: database/resumeIntroLines/0/lines/2
    english: What
    thai: "\u0E2D\u0E30\u0E44\u0E23\u0E19\u0E30"
  - key: database/resumeIntroLines/1/text
    english: Let's make it better.
    thai: "\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E21\u0E31\u0E19\u0E14\u0E35\u0E02\u0E36\u0E49\u0E19\u0E01\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30"
  - key: database/defaultHrIntro/0/text
    english: Good morning, {name}. Please have a seat.
    thai: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E15\u0E2D\u0E19\u0E40\u0E0A\u0E49\u0E32\u0E04\u0E48\u0E30/\u0E04\u0E23\u0E31\u0E1A \u0E04\u0E38\u0E13{name} \u0E40\u0E0A\u0E34\u0E0D\u0E19\u0E31\u0E48\u0E07\u0E01\u0E48\u0E2D\u0E19"
  - key: speaker/HR
    english: HR
    thai: HR
  - key: database/hrReviewLines/0/text
    english: Let me look at your resume.
    thai: "\u0E02\u0E2D\u0E14\u0E39\u0E40\u0E23\u0E0B\u0E39\u0E40\u0E21\u0E48\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E19\u0E30"
  - key: database/hrReviewLines/1/text
    english: '{name}. A recent graduate.'
    thai: "{name} \u0E40\u0E14\u0E47\u0E01\u0E08\u0E1A\u0E43\u0E2B\u0E21\u0E48\u0E2A\u0E34\u0E19\u0E30"
  - key: database/rejectionHR/0/text
    english: Thank you for your time, {name}.
    thai: "\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E17\u0E35\u0E48\u0E2A\u0E25\u0E30\u0E40\u0E27\u0E25\u0E32\u0E21\u0E32\u0E19\u0E30 \u0E04\u0E38\u0E13{name}"
  - key: database/rejectionHR/1/text
    english: We've decided to move forward with other candidates.
    thai: "\u0E40\u0E23\u0E32\u0E15\u0E31\u0E14\u0E2A\u0E34\u0E19\u0E43\u0E08\u0E40\u0E14\u0E34\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E01\u0E31\u0E1A\u0E1C\u0E39\u0E49\u0E2A\u0E21\u0E31\u0E04\u0E23\u0E17\u0E48\u0E32\u0E19\u0E2D\u0E37\u0E48\u0E19"
  - key: database/rejectionPlayer/0/text
    english: ...Again.
    thai: "...\u0E2D\u0E35\u0E01\u0E41\u0E25\u0E49\u0E27"
  - key: database/rejectionPlayer/1/text
    english: Time to go home.
    thai: "\u0E01\u0E25\u0E31\u0E1A\u0E1A\u0E49\u0E32\u0E19\u0E01\u0E31\u0E19\u0E40\u0E16\u0E2D\u0E30"
  - key: database/fatherOfferLines/0/text
    english: The phone is ringing. It's Dad.
    thai: "\u0E42\u0E17\u0E23\u0E28\u0E31\u0E1E\u0E17\u0E4C\u0E14\u0E31\u0E07\u0E02\u0E36\u0E49\u0E19 \u0E1E\u0E48\u0E2D\u0E42\u0E17\u0E23\u0E21\u0E32"
  - key: speaker/Narrator
    english: Narrator
    thai: "\u0E1C\u0E39\u0E49\u0E1A\u0E23\u0E23\u0E22\u0E32\u0E22"
  - key: database/fatherOfferLines/1/text
    english: '{name}, I''ve been thinking. There''s an opening at my friend''s company.'
    thai: "{name} \u0E1E\u0E48\u0E2D\u0E04\u0E34\u0E14\u0E21\u0E32\u0E2A\u0E31\u0E01\u0E1E\u0E31\u0E01\u0E41\u0E25\u0E49\u0E27\u0E19\u0E30 \u0E17\u0E35\u0E48\u0E1A\u0E23\u0E34\u0E29\u0E31\u0E17\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E1E\u0E48\u0E2D\u0E21\u0E35\u0E15\u0E33\u0E41\u0E2B\u0E19\u0E48\u0E07\u0E27\u0E48\u0E32\u0E07\u0E2D\u0E22\u0E39\u0E48"
  - key: speaker/Father
    english: Father
    thai: "\u0E1E\u0E48\u0E2D"
  - key: database/fatherOfferLines/2/text
    english: Steady pay. Regular hours. You don't have to keep doing this.
    thai: "\u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E21\u0E31\u0E48\u0E19\u0E04\u0E07 \u0E40\u0E27\u0E25\u0E32\u0E17\u0E33\u0E07\u0E32\u0E19\u0E41\u0E19\u0E48\u0E19\u0E2D\u0E19 \u0E25\u0E39\u0E01\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E17\u0E19\u0E17\u0E33\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49\u0E15\u0E48\u0E2D\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27"
  - key: database/fatherOfferLines/3/text
    english: I... I don't have anything left to apply to.
    thai: "\u0E2B\u0E19\u0E39... \u0E44\u0E21\u0E48\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E17\u0E35\u0E48\u0E43\u0E2B\u0E49\u0E2A\u0E21\u0E31\u0E04\u0E23\u0E41\u0E25\u0E49\u0E27\u0E04\u0E48\u0E30/\u0E04\u0E23\u0E31\u0E1A"
  - key: database/fatherOfferLines/4/text
    english: Then take it. What do you say?
    thai: "\u0E07\u0E31\u0E49\u0E19\u0E01\u0E47\u0E23\u0E31\u0E1A\u0E07\u0E32\u0E19\u0E19\u0E35\u0E49\u0E40\u0E16\u0E2D\u0E30 \u0E27\u0E48\u0E32\u0E44\u0E07\u0E25\u0E39\u0E01?"
