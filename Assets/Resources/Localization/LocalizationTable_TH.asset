  - key: company/company_pixel_pioneers/companyName
    english: Pixel Pioneers
    thai: Pixel Pioneers
  - key: company/company_pixel_pioneers/jobTitle
    english: Junior Game Designer
    thai: "\u0E19\u0E31\u0E01\u0E2D\u0E2D\u0E01\u0E41\u0E1A\u0E1A\u0E40\u0E01\u0E21\u0E08\u0E39\u0E40\u0E19\u0E35\u0E22\u0E23\u0E4C"
  - key: company/company_pixel_pioneers/salary
    english: $2,400 / month
    thai: "$2,400 / \u0E40\u0E14\u0E37\u0E2D\u0E19"
  - key: company/company_pixel_pioneers/industry
    english: Game Studio
    thai: "\u0E2A\u0E15\u0E39\u0E14\u0E34\u0E42\u0E2D\u0E40\u0E01\u0E21"
  - key: company/company_pixel_pioneers/description
    english: A small studio with big plans and no budget.
    thai: "\u0E2A\u0E15\u0E39\u0E14\u0E34\u0E42\u0E2D\u0E40\u0E25\u0E47\u0E01 \u0E46 \u0E17\u0E35\u0E48\u0E21\u0E35\u0E41\u0E1C\u0E19\u0E43\u0E2B\u0E0D\u0E48\u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E07\u0E1A"
  - key: company/company_pixel_pioneers/playerReaction/0/text
    english: A game studio... this could actually be it.
    thai: "\u0E2A\u0E15\u0E39\u0E14\u0E34\u0E42\u0E2D\u0E40\u0E01\u0E21... \u0E19\u0E35\u0E48\u0E2D\u0E32\u0E08\u0E40\u0E1B\u0E47\u0E19\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48\u0E08\u0E23\u0E34\u0E07 \u0E46 \u0E01\u0E47\u0E44\u0E14\u0E49"
  - key: company/company_pixel_pioneers/hrIntro/0/text
    english: Welcome to Pixel Pioneers. Please sit.
    thai: "\u0E22\u0E34\u0E19\u0E14\u0E35\u0E15\u0E49\u0E2D\u0E19\u0E23\u0E31\u0E1A\u0E2A\u0E39\u0E48 Pixel Pioneers \u0E40\u0E0A\u0E34\u0E0D\u0E19\u0E31\u0E48\u0E07\u0E04\u0E48\u0E30/\u0E04\u0E23\u0E31\u0E1A"
  - key: company/company_brightline/companyName
    english: Brightline Corp
    thai: Brightline Corp
  - key: company/company_brightline/jobTitle
    english: Assistant Account Executive
    thai: "\u0E1C\u0E39\u0E49\u0E0A\u0E48\u0E27\u0E22\u0E1C\u0E39\u0E49\u0E08\u0E31\u0E14\u0E01\u0E32\u0E23\u0E1D\u0E48\u0E32\u0E22\u0E25\u0E39\u0E01\u0E04\u0E49\u0E32"
  - key: company/company_brightline/salary
    english: $3,100 / month
    thai: "$3,100 / \u0E40\u0E14\u0E37\u0E2D\u0E19"
  - key: company/company_brightline/industry
    english: Marketing
    thai: "\u0E01\u0E32\u0E23\u0E15\u0E25\u0E32\u0E14"
  - key: company/company_brightline/description
    english: Fast-paced. Lots of meetings.
    thai: "\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E40\u0E23\u0E47\u0E27 \u0E1B\u0E23\u0E30\u0E0A\u0E38\u0E21\u0E40\u0E22\u0E2D\u0E30"
  - key: company/company_brightline/playerReaction/0/text
    english: Marketing. I don't know anything about marketing.
    thai: "\u0E01\u0E32\u0E23\u0E15\u0E25\u0E32\u0E14\u0E40\u0E2B\u0E23\u0E2D... \u0E40\u0E23\u0E32\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E15\u0E25\u0E32\u0E14\u0E40\u0E25\u0E22"
  - key: company/company_brightline/hrIntro/0/text
    english: Thank you for coming to Brightline. Let's begin.
    thai: "\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E17\u0E35\u0E48\u0E21\u0E32\u0E17\u0E35\u0E48 Brightline \u0E40\u0E23\u0E34\u0E48\u0E21\u0E01\u0E31\u0E19\u0E40\u0E25\u0E22\u0E19\u0E30"
