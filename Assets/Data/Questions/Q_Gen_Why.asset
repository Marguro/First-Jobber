  answers:
  - id: a1
    text: Because I'm motivated.
    playerReaction:
    - speaker: Player
      text: Because I need to eat.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: So are the others.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a2
    text: I'm not sure you should.
    playerReaction:
    - speaker: Player
      text: Why did I say that?
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Interesting.
      emotion: 3
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a3
    text: Because I won't give up.
    playerReaction:
    - speaker: Player
      text: I won't. I can't.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
