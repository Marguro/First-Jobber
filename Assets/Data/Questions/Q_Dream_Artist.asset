  answers:
  - id: a1
    text: I never stop practicing.
    playerReaction:
    - speaker: Player
      text: I practice every night.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Practice isn't a deliverable.
      emotion: 2
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a2
    text: I can learn other skills.
