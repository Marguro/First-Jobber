  id: q_passion_game_design
  questionText: Game design is a hobby for most people. Why is it more for you?
  hrEmotion: 0
  linkedChoice: {fileID: 11400000, guid: d7532bb462bbc724b970d59aac0a8a92, type: 2}
  linkedCategory: {fileID: 0}
  requiredCompany: {fileID: 0}
  requiredTag: 
  weight: 1
  answers:
  - id: a1
    text: I've finished three prototypes.
    playerReaction:
    - speaker: Player
      text: None of them are good. But they exist.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Prototypes. On your own time.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a2
    text: It's how I understand people.
    playerReaction:
    - speaker: Player
      text: That's the truest thing I've said today.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Interesting. Unusual.
      emotion: 1
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a3
    text: I don't know.
    playerReaction:
    - speaker: Player
      text: I really don't.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Then why list it?
