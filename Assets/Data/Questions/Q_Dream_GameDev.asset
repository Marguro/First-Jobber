  id: q_dream_game_dev
  questionText: Why do you want to become a game developer?
  hrEmotion: 3
  linkedChoice: {fileID: 11400000, guid: 256acfdc3444f3b45a526b1e228361ef, type: 2}
  linkedCategory: {fileID: 0}
  requiredCompany: {fileID: 0}
  requiredTag: 
  weight: 1
  answers:
  - id: a1
    text: I love creating experiences.
    playerReaction:
    - speaker: Player
      text: Games have always meant something to me.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Passion alone doesn't make you qualified.
      emotion: 2
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a2
    text: I want to make people feel something.
    playerReaction:
    - speaker: Player
      text: That sounded better in my head.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: This is a business, not an art project.
      emotion: 3
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a3
    text: It's stable enough these days.
    playerReaction:
    - speaker: Player
      text: That's not even true.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: That is... not true at all.
      emotion: 2
      autoAdvanceDelay: 0
