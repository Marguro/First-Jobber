  answers:
  - id: a1
    text: It taught me discipline.
    playerReaction:
    - speaker: Player
      text: Hours of scales, nobody listening.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Discipline. We value that.
      emotion: 1
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a2
    text: It doesn't, really.
    playerReaction:
    - speaker: Player
      text: I should have lied.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Then why is it here?
      emotion: 2
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a3
    text: I can keep a team in rhythm.
    playerReaction:
    - speaker: Player
      text: That's a stretch.
      emotion: 0
