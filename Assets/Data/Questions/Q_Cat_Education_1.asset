  answers:
  - id: a1
    text: I mostly studied alone.
    playerReaction:
    - speaker: Player
      text: It was a lonely four years.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Self-motivated, then.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a2
    text: I joined every club I could.
    playerReaction:
    - speaker: Player
      text: And finished none of them.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Involved. Good.
      emotion: 1
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a3
    text: I'd rather talk about the future.
    playerReaction:
    - speaker: Player
      text: Please change the subject.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
