  id: q_edu_small_town
  questionText: Why did you choose Small Town University?
  hrEmotion: 2
  linkedChoice: {fileID: 11400000, guid: bd7e952ce5bdeb94da82376987b3ed97, type: 2}
  linkedCategory: {fileID: 0}
  requiredCompany: {fileID: 0}
