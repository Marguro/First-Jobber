  answers:
  - id: a1
    text: It was close to home.
    playerReaction:
    - speaker: Player
      text: Not the most inspiring answer.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Convenient. I suppose.
      emotion: 2
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a2
    text: It taught me to work with what I have.
    playerReaction:
    - speaker: Player
      text: I almost believe that myself.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: That's a nice way to say it.
      emotion: 1
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
  - id: a3
    text: I couldn't afford anywhere else.
    playerReaction:
    - speaker: Player
      text: Why did I say that out loud?
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Oh. I see.
