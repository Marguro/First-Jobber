  - id: a2
    text: No.
    playerReaction:
    - speaker: Player
      text: It's the only thing I have.
      emotion: 0
      autoAdvanceDelay: 0
      delayBefore: 0
      eventId: 
      portrait: {fileID: 0}
    hrResponse:
    - speaker: HR
      text: Then why are you here?
