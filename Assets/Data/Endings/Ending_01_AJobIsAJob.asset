  id: ending_job_is_a_job
  title: A Job Is a Job
  optionLabel: Accept father's offer
  optionDescription: Take the office job. No more rejections.
  lines:
  - speaker: Narrator
    text: Monday. The office smells like old coffee.
    emotion: 0
    autoAdvanceDelay: 0
    delayBefore: 0
    eventId: 
    portrait: {fileID: 0}
  - speaker: Player
    text: I escaped the interviews. I didn't escape the routine.
    emotion: 0
    autoAdvanceDelay: 0
    delayBefore: 0
    eventId: 
    portrait: {fileID: 0}
  - speaker: Narrator
    text: Every desk looks the same. So does every day.
    emotion: 0
    autoAdvanceDelay: 0
    delayBefore: 0
    eventId: 
    portrait: {fileID: 0}
  - speaker: Player
    text: It's a job. A job is a job.
    emotion: 0
    autoAdvanceDelay: 0
    delayBefore: 0
    eventId: 
    portrait: {fileID: 0}
